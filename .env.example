# PostgreSQL connection string (Neon/Supabase/local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/flux?schema=public"

# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# Public URL of the app (needed in production, e.g. https://flux.vercel.app)
AUTH_URL="http://localhost:3000"

# Shared secret for the scheduled recurring-transactions job (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""
